# Placeholders only. `python3 scripts/init_env.py` writes .env from this file with a fresh
# random secret in place of every placeholder value; the servers refuse to start with a
# placeholder as their service credential.
# Postgres (owner role, used by migrations and the admin CLI)
POSTGRES_USER=ai_gateway_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=ai_gateway
# Least-privilege role the gateway connects as
GATEWAY_APP_DB_PASSWORD=change-me-app-password
GATEWAY_DATABASE_URL=postgresql://gateway_app:change-me-app-password@127.0.0.1:4402/ai_gateway
GATEWAY_MIGRATE_DATABASE_URL=postgresql://ai_gateway_owner:change-me-owner-password@127.0.0.1:4402/ai_gateway
# Test database used by `pytest -m integration`
GATEWAY_TEST_DATABASE_URL=postgresql://ai_gateway_owner:change-me-owner-password@127.0.0.1:4402/ai_gateway_test
GATEWAY_TEST_APP_DATABASE_URL=postgresql://gateway_app:change-me-app-password@127.0.0.1:4402/ai_gateway_test
# Telemetry: spans and decision records, in the `telemetry` schema. Three roles, created by
# `gateway-admin telemetry-setup` (the telemetry-setup service): the gateway only appends, the
# dashboard only reads a few views, and the purge only deletes old rows.
TELEMETRY_WRITER_DB_PASSWORD=change-me-telemetry-writer-password
TELEMETRY_READER_DB_PASSWORD=change-me-telemetry-reader-password
TELEMETRY_PURGER_DB_PASSWORD=change-me-telemetry-purger-password
# The writer, for a gateway run on the host (the Compose gateway builds its own URL)
GATEWAY_TELEMETRY_DATABASE_URL=postgresql://telemetry_writer:change-me-telemetry-writer-password@127.0.0.1:4402/ai_gateway
# The reader, for scripts that read the dashboard's views (scripts/simulate_traffic.py --verify)
TELEMETRY_READER_DATABASE_URL=postgresql://telemetry_reader:change-me-telemetry-reader-password@127.0.0.1:4402/ai_gateway
# Test database roles used by `pytest` for the telemetry tests
TELEMETRY_WRITER_TEST_DATABASE_URL=postgresql://telemetry_writer:change-me-telemetry-writer-password@127.0.0.1:4402/ai_gateway_test
TELEMETRY_READER_TEST_DATABASE_URL=postgresql://telemetry_reader:change-me-telemetry-reader-password@127.0.0.1:4402/ai_gateway_test
TELEMETRY_PURGER_TEST_DATABASE_URL=postgresql://telemetry_purger:change-me-telemetry-purger-password@127.0.0.1:4402/ai_gateway_test
# Policy: the audit log and the approval queue (agent-core's), in the `policy` schema. Three roles,
# created by `gateway-admin policy-setup` (the policy-setup service): the gateway appends audit
# records and uses approvals, a person's tool decides approvals, and the auditor only reads the log.
POLICY_GATEWAY_DB_PASSWORD=change-me-policy-gateway-password
POLICY_APPROVER_DB_PASSWORD=change-me-policy-approver-password
# The lab approver's password, for the lab profile only (docs/architecture.md). Empty: no such role.
POLICY_LAB_APPROVER_DB_PASSWORD=
POLICY_AUDITOR_DB_PASSWORD=change-me-policy-auditor-password
# The gateway's, for a gateway run on the host (the Compose gateway builds its own URL)
GATEWAY_POLICY_DATABASE_URL=postgresql://policy_gateway:change-me-policy-gateway-password@127.0.0.1:4402/ai_gateway
# The auditor's, for `gateway-admin audit-anchor` and `audit-verify`
POLICY_AUDITOR_DATABASE_URL=postgresql://policy_auditor:change-me-policy-auditor-password@127.0.0.1:4402/ai_gateway
# The approver's, for the approval tools (Phase 3b)
POLICY_APPROVER_DATABASE_URL=postgresql://policy_approver:change-me-policy-approver-password@127.0.0.1:4402/ai_gateway
# Test database roles used by `pytest` for the policy tests
POLICY_GATEWAY_TEST_DATABASE_URL=postgresql://policy_gateway:change-me-policy-gateway-password@127.0.0.1:4402/ai_gateway_test
POLICY_APPROVER_TEST_DATABASE_URL=postgresql://policy_approver:change-me-policy-approver-password@127.0.0.1:4402/ai_gateway_test
POLICY_AUDITOR_TEST_DATABASE_URL=postgresql://policy_auditor:change-me-policy-auditor-password@127.0.0.1:4402/ai_gateway_test
# Gateway
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=4401
GATEWAY_PIPELINE_FILE=config/pipeline.toml
GATEWAY_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
GATEWAY_LOG_LEVEL=INFO
# Test client: a token printed once by `gateway-admin token issue`; never commit a real one
GATEWAY_TOKEN=
# Ticketing MCP server (Harborline Supply Co. is fictional)
# Password of the ticketing_app role, created by the servers-setup service
TICKETING_DB_PASSWORD=change-me-ticketing-password
# Credential the gateway presents to the ticketing server (set the same value for both)
TICKETING_SERVICE_TOKEN=change-me-ticketing-service-token
TICKETING_DATABASE_URL=postgresql://ticketing_app:change-me-ticketing-password@127.0.0.1:4402/ai_gateway
# Test database role used by `pytest` for the ticketing tests
TICKETING_TEST_APP_DATABASE_URL=postgresql://ticketing_app:change-me-ticketing-password@127.0.0.1:4402/ai_gateway_test
# CRM MCP server (Harborline Supply Co. is fictional)
# Password of the crm_app role, created by the servers-setup service
CRM_DB_PASSWORD=change-me-crm-password
# Credential the gateway presents to the CRM server (set the same value for both)
CRM_SERVICE_TOKEN=change-me-crm-service-token
CRM_DATABASE_URL=postgresql://crm_app:change-me-crm-password@127.0.0.1:4402/ai_gateway
# Test database role used by `pytest` for the CRM tests
CRM_TEST_APP_DATABASE_URL=postgresql://crm_app:change-me-crm-password@127.0.0.1:4402/ai_gateway_test
# Handbook MCP server (Harborline Supply Co. is fictional)
# Password of the handbook_app role, created by the servers-setup service
HANDBOOK_DB_PASSWORD=change-me-handbook-password
# Credential the gateway presents to the handbook server (set the same value for both)
HANDBOOK_SERVICE_TOKEN=change-me-handbook-service-token
HANDBOOK_DATABASE_URL=postgresql://handbook_app:change-me-handbook-password@127.0.0.1:4402/ai_gateway
# Test database role used by `pytest` for the handbook tests
HANDBOOK_TEST_APP_DATABASE_URL=postgresql://handbook_app:change-me-handbook-password@127.0.0.1:4402/ai_gateway_test
# Where the embedding model is (python3 scripts/fetch_model.py --dest <directory>). Tests use
# ~/.cache/ai-gateway/models/potion-base-8M when this is not set; the Compose services set
# it themselves, to the copy baked into the image.
# HANDBOOK_MODEL_PATH=/path/to/potion-base-8M
