# Postgres (owner role, used by migrations and the admin CLI)
POSTGRES_USER=ai_gateway_owner
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=ai_gateway
# Least-privilege role the gateway connects as
GATEWAY_APP_DB_PASSWORD=change-me-app-password
GATEWAY_DATABASE_URL=postgresql://gateway_app:change-me-app-password@127.0.0.1:4402/ai_gateway
GATEWAY_MIGRATE_DATABASE_URL=postgresql://ai_gateway_owner:change-me-owner-password@127.0.0.1:4402/ai_gateway
# Test database used by `pytest -m integration`
GATEWAY_TEST_DATABASE_URL=postgresql://ai_gateway_owner:change-me-owner-password@127.0.0.1:4402/ai_gateway_test
GATEWAY_TEST_APP_DATABASE_URL=postgresql://gateway_app:change-me-app-password@127.0.0.1:4402/ai_gateway_test
# Gateway
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=4401
GATEWAY_PIPELINE_FILE=config/pipeline.toml
GATEWAY_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
GATEWAY_LOG_LEVEL=INFO
# Test client: a token printed once by `gateway-admin token issue`; never commit a real one
GATEWAY_TOKEN=
# Ticketing MCP server (Harborline Supply Co. is fictional)
# Password of the ticketing_app role, created by the servers-setup service
TICKETING_DB_PASSWORD=change-me-ticketing-password
# Credential the gateway presents to the ticketing server (set the same value for both)
TICKETING_SERVICE_TOKEN=change-me-ticketing-service-token
TICKETING_DATABASE_URL=postgresql://ticketing_app:change-me-ticketing-password@127.0.0.1:4402/ai_gateway
# Test database role used by `pytest` for the ticketing tests
TICKETING_TEST_APP_DATABASE_URL=postgresql://ticketing_app:change-me-ticketing-password@127.0.0.1:4402/ai_gateway_test
